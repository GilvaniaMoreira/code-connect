# PostgreSQL (docker-compose)
POSTGRES_USER=code_connect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=code_connect
POSTGRES_PORT=5432

# API — Prisma / auth
DATABASE_URL=postgresql://code_connect:change-me@localhost:5432/code_connect?schema=public
# JWT_SECRET is required — the API refuses to boot when unset. Use a long random
# value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me
PORT=3000
